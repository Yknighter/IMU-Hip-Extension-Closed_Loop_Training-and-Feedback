{
  "user_guide_file": "Hip Extension App Guide.pdf",
  "app_name": "IMU Hip Extension Feedback V19.9v",
  "app_description": "V19.9v build 901900: gap-aware feedback; interrupted actions are discarded; fresh data, filter warmup and 200 ms neutral rearming are required before new rewards. CSV recording with dynamic gap/recovery diagnostics.",
  "app_id": "901",
  "app_version": "1_19_9vibrant",
  "version_id": "901900",
  "validated_version_range": [
    "3.20.1",
    "4.6.6"
  ],
  "parameters_setting": [
    [
      "Training Setting",
      {
        "source": "feedback_enabled",
        "title": "Feedback Enabled",
        "type": "bool",
        "description": "Enable or disable all vibration feedback."
      },
      {
        "source": "training_leg",
        "title": "Training Leg",
        "type": "combo",
        "validation": [
          "right",
          "left"
        ],
        "description": "Selected hip side used for assessment and training."
      },
      {
        "source": "adaptive_threshold_enabled",
        "title": "Auto Assessment and Leveling",
        "type": "bool",
        "description": "Silent assessment and automatic target progression. Target upgrades do not vibrate."
      },
      {
        "source": "adaptive_assessment_sec",
        "title": "Assessment Seconds",
        "type": "float",
        "validation": [
          5,
          300
        ],
        "description": "Initial walking assessment duration before formal training starts. Default 60 seconds."
      },
      {
        "source": "adaptive_interval_sec",
        "title": "Training Window Seconds",
        "type": "float",
        "validation": [
          5,
          300
        ],
        "description": "Training window duration used for success-ratio based level advancement. Default 60 seconds."
      },
      {
        "source": "adaptive_step_deg",
        "title": "Level Step Degrees",
        "type": "float",
        "validation": [
          1,
          14
        ],
        "description": "Target increase per level-up, in degrees. Use 1 for 1-degree levels, 3 for five levels to 15 degrees, or 5 for three levels to 15 degrees."
      },
      {
        "source": "adaptive_success_ratio_required",
        "title": "Level Up Success Ratio",
        "type": "float",
        "validation": [
          0,
          1
        ],
        "description": "Minimum success ratio required to advance by the configured step size. Default 0.8."
      },
      {
        "source": "adaptive_threshold_limit",
        "title": "Max Target Degrees",
        "type": "float",
        "validation": [
          1,
          30
        ],
        "description": "Maximum automatic training target. Default 15 degrees."
      },
      {
        "title": "Min Valid Steps Per Window",
        "source": "adaptive_min_valid_steps_per_window",
        "type": "int",
        "default": 8,
        "min": 0,
        "max": 60
      },
      {
        "title": "Min Extension Episode ms",
        "source": "adaptive_min_extension_episode_ms",
        "type": "float",
        "default": 200,
        "min": 50,
        "max": 1000
      },
      {
        "title": "Extension End Dwell ms",
        "source": "adaptive_extension_episode_end_dwell_ms",
        "type": "float",
        "default": 200,
        "min": 50,
        "max": 1000
      },
      {
        "title": "Min Valid Peak Degrees",
        "source": "adaptive_min_valid_peak_deg",
        "type": "float",
        "default": 0.5,
        "min": 0,
        "max": 5
      },
      {
        "source": "moving_average_window",
        "title": "Smoothing Samples",
        "type": "int",
        "validation": [
          1,
          50
        ],
        "description": "Number of samples used to smooth hip angle."
      },
      {
        "source": "min_threshold",
        "title": "Fixed Target Degrees",
        "type": "float",
        "validation": [
          0.5,
          30
        ],
        "description": "Used when automatic assessment is disabled."
      },
      {
        "source": "reward_pulse_duration",
        "title": "Success Pulse Seconds",
        "type": "float",
        "validation": [
          0.05,
          0.25
        ],
        "description": "One pulse per qualifying extension cycle, hard-capped at 0.25 seconds. Default 0.2 seconds. Holding the same extension angle does not retrigger."
      },
      {
        "source": "reward_strength",
        "title": "Feedback Strength (1-4)",
        "type": "int",
        "validation": [
          1,
          4
        ],
        "description": "One fixed strength for success pulses. Default 2. Reduce if too strong for the participant. Training does not change strength."
      },
      {
        "source": "reward_target_dwell_ms",
        "title": "Target Confirmation ms",
        "type": "float",
        "validation": [
          0,
          200
        ],
        "description": "Continuous time at or above target before reward. Default 30 ms."
      }
    ],
    [
      "Vibration Measurement",
      {
        "source": "vibration_detection_threshold_mps2",
        "title": "Measured vibration RMS threshold (0 = record only)",
        "type": "float",
        "validation": [
          0,
          100
        ],
        "description": "Engineering setting. Validate the detector against actual motor on/off trials; threshold 0 leaves detection unknown."
      },
      {
        "source": "vibration_highpass_hz",
        "title": "Vibration high-pass cutoff (Hz)",
        "type": "float",
        "validation": [
          1,
          40
        ],
        "description": "Engineering setting. Validate the detector against actual motor on/off trials; threshold 0 leaves detection unknown."
      },
      {
        "source": "vibration_rms_window_ms",
        "title": "Vibration RMS window (ms)",
        "type": "float",
        "validation": [
          20,
          200
        ],
        "description": "Engineering setting. Validate the detector against actual motor on/off trials; threshold 0 leaves detection unknown."
      },
      {
        "source": "vibration_match_tolerance_sec",
        "title": "Command / measurement tolerance (seconds)",
        "type": "float",
        "validation": [
          0,
          1
        ],
        "description": "Engineering setting. Validate the detector against actual motor on/off trials; threshold 0 leaves detection unknown."
      }
    ]
  ],
